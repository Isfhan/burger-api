{
  "name": "@burger-api/cli",
  "version": "0.1.0",
  "description": "Simple command-line tool for Burger API projects",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "burger-api": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build:win": "bun build ./src/index.ts --compile --target bun-windows-x64 --outfile dist/burger-api.exe --minify --bytecode",
    "build:linux": "bun build ./src/index.ts --compile --target bun-linux-x64 --outfile dist/burger-api-linux --minify --bytecode",
    "build:mac": "bun build ./src/index.ts --compile --target bun-darwin-arm64 --outfile dist/burger-api-mac --minify --bytecode",
    "build:all": "bun run build:win && bun run build:linux && bun run build:mac"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "@clack/prompts": "^0.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/commander": "^2.12.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "keywords": [
    "burger-api",
    "cli",
    "framework",
    "bun"
  ],
  "author": "Isfhan Ahmed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isfhan/burger-api.git",
    "directory": "packages/cli"
  }
}
