{
  "name": "@burger-api/cli",
  "version": "1.0.0-beta",
  "description": "Official CLI for BurgerAPI: create projects, add hooks and plugins, run a dev server, and build for Bun, Node, Cloudflare Workers, Deno and Vercel.",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "burger-api": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test --timeout 30000 ./test --path-ignore-patterns='**/e2e/**' --path-ignore-patterns='**/e2e-full/**'",
    "test:e2e": "bun test --timeout 30000 ./test/e2e",
    "test:e2e:full": "bun test --timeout 600000 ./test/e2e-full",
    "typecheck": "tsc --noEmit",
    "test:build": "bun test test/scanner.test.ts test/virtual-entry.test.ts test/entry-options.test.ts test/build-preserve-options.test.ts",
    "build:win": "bun run scripts/build-executable.ts win",
    "build:linux": "bun run scripts/build-executable.ts linux",
    "build:mac": "bun run scripts/build-executable.ts mac",
    "build:mac-intel": "bun run scripts/build-executable.ts mac-intel",
    "build:all": "bun run build:win && bun run build:linux && bun run build:mac && bun run build:mac-intel"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "burger-api": "^1.0.0-beta",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "keywords": [
    "burger-api",
    "cli",
    "framework",
    "bun"
  ],
  "author": "Isfhan Ahmed",
  "license": "MIT",
  "homepage": "https://burger-api.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Isfhan/burger-api.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
