{
  "name": "burger-api",
  "version": "0.15.0",
  "author": "Isfhan Ahmed",
  "type": "module",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "prepare": "bun run build",
    "test": "bun run test:examples && bun run test:ecosystem && bun run test:lifecycle && bun run test:context && bun run test:chain && bun run test:plugin && bun run test:router && bun run test:core && bun run test:errors && bun run test:smoke",
    "test:examples": "bun test --timeout 30000 --max-concurrency 1 examples/**/*.test.ts",
    "test:ecosystem": "bun test --timeout 60000 --max-concurrency 1 test/ecosystem-middleware-smoke.test.ts",
    "test:lifecycle": "bun test --timeout 30000 test/lifecycle/**/*.test.ts",
    "test:context": "bun test --timeout 30000 test/context/**/*.test.ts",
    "test:chain": "bun test --timeout 30000 test/chain/**/*.test.ts",
    "test:plugin": "bun test --timeout 30000 test/plugin/**/*.test.ts",
    "test:router": "bun test --timeout 30000 test/router/**/*.test.ts",
    "test:core": "bun test --timeout 30000 test/core/**/*.test.ts",
    "test:errors": "bun test --timeout 30000 test/errors/**/*.test.ts",
    "test:smoke": "bun test --timeout 30000 test/plugin-macro-smoke.test.ts",
    "dev": "bun run examples/file-base-static-page-routing-app/index.ts"
  },
  "keywords": [
    "burger-api",
    "burger-api-framework",
    "bun",
    "bunjs",
    "bun-framework",
    "fast-backend",
    "javascript-backend",
    "high-performance",
    "esm",
    "typescript",
    "openapi",
    "swagger-ui",
    "declarative-routing",
    "api-framework",
    "modern-backend",
    "backend-framework",
    "server",
    "bun-native",
    "js-backend",
    "fast-api",
    "scalable-backend",
    "backend-development",
    "modern-api",
    "api-development",
    "backend-engine",
    "efficient",
    "minimalist-backend",
    "bun-powered",
    "open-source",
    "typescript-backend",
    "performance",
    "rapid-development",
    "web-framework",
    "api-server",
    "dynamic-routing",
    "backend-routing",
    "extensible",
    "modular",
    "declarative-api",
    "lightweight",
    "contemporary-backend",
    "fast-javascript",
    "bun-js-framework",
    "bun-backend",
    "bun-api-framework",
    "pakistan-backend",
    "pakistan-api-framework",
    "pakistan-api-server",
    "pakistan-backend-framework",
    "pakistan-bunjs-framework",
    "pakistan-javascript-framework"
  ],
